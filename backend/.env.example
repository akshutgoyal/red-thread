# Red Thread configuration
# Copy this file to backend/.env (or the project-root .env) and edit values.
# Never commit a real .env file.

RED_THREAD_ENVIRONMENT=development
# Local mode: leave unset to use <project>/data and <project>/reports.
# RED_THREAD_DATA_DIR=./data
# RED_THREAD_REPORTS_DIR=./reports
# SQLite local default:
# RED_THREAD_DATABASE_URL=sqlite:///./data/red-thread.db
# Supabase/Postgres (the app converts postgresql:// to the psycopg driver):
# RED_THREAD_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
RED_THREAD_MAX_UPLOAD_MB=50
RED_THREAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RED_THREAD_ENABLE_LIVE_MONITOR=false

# Seed the two synthetic demo cases on startup. Idempotent.
RED_THREAD_SEED_DEMO=false
# Optional sample data override (defaults to <project>/sample_data).
# RED_THREAD_SAMPLE_DATA_DIR=./sample_data

# Storage: local | r2
RED_THREAD_STORAGE_BACKEND=local
# Cloudflare R2 (required when RED_THREAD_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
R2_REGION=auto

# Auth parser defaults
RED_THREAD_AUTH_DEFAULT_TIMEZONE=UTC
# Default timezone for financial, call, chat and invoice evidence.
RED_THREAD_DEFAULT_TIMEZONE=Asia/Kolkata
# Optional. Leave unset to infer the year from the evidence upload date.
# RED_THREAD_AUTH_DEFAULT_YEAR=2026

# AI provider selection: auto | commandcode | tokenharbor | none
RED_THREAD_AI_PROVIDER=auto
RED_THREAD_AI_TIMEOUT_SECONDS=60
RED_THREAD_AI_MAX_RETRIES=2
RED_THREAD_AI_MAX_CONTEXT_CHARS=60000
# Reasoning models may spend tokens on reasoning before emitting the answer.
# TokenHarbor's free DeepSeek route may need 16384 for a large context.
RED_THREAD_AI_MAX_TOKENS=8192
RED_THREAD_AI_REDACT_PII=true

# CommandCode Provider API (official docs: https://commandcode.ai/docs/provider)
# API access requires a plan other than Go. The same key works for CLI and API.
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash
COMMANDCODE_ZDR=true

# TokenHarbor (OpenAI-compatible; free DeepSeek V4.1 Flash route)
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free

# Optional OCR binary path (only needed if tesseract is not on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
