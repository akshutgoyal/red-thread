# Optional frontend configuration.
# Local development can leave VITE_API_BASE_URL unset to use the Vite /api proxy.
# For the Vercel deployment set it to the Render API, for example:
# VITE_API_BASE_URL=https://red-thread-api.onrender.com/api
# Optional: point the spatial view at a local OpenStreetMap-compatible tile server.
# VITE_MAP_TILE_URL=http://localhost:8080/styles/osm-bright/{z}/{x}/{y}.png

# Google Identity Services client ID (public browser key)
VITE_GOOGLE_CLIENT_ID=
